theorem power3 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : (L δ ^ 3) A = stage3 δ A := by
  change (L δ ^ (2+1)) A = stage3 δ A
  rw [pow_succ',Module.End.mul_apply]
  have hp := congrArg (fun B => L δ B) (power2 δ A)
  refine hp.trans ?_
  change H δ * (stage2 δ A) - (stage2 δ A) * H δ = stage3 δ A
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero] <;>
    simp [H, stage3, stage2] <;> ring

