import Krylov.Perturbation
import Krylov.FactorTwo
import Krylov.PurifiedCovariance

/-! Exact annihilator certificate for the perturbed qutrit commutator.
Each symbolic stage is checked by ring normalization in Lean; the generator
is not a trusted oracle. The same identity holds on each ancilla block. -/
namespace Krylov.Annihilator
open Matrix
open scoped BigOperators Kronecker
noncomputable section
set_option maxHeartbeats 5000000

def H (δ : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := !![0,1,δ;1,0,2*δ;δ,2*δ,0]

def L (δ : ℂ) : Module.End ℂ (Matrix (Fin 3) (Fin 3) ℂ) := FactorTwo.commutator (H δ)

def stage1 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ :=
  !![(-1) * A 0 1 + (-δ) * A 0 2 + (1) * A 1 0 + (δ) * A 2 0, (-1) * A 0 0 + (-2*δ) * A 0 2 + (1) * A 1 1 + (δ) * A 2 1, (-δ) * A 0 0 + (-2*δ) * A 0 1 + (1) * A 1 2 + (δ) * A 2 2;
    (1) * A 0 0 + (-1) * A 1 1 + (-δ) * A 1 2 + (2*δ) * A 2 0, (1) * A 0 1 + (-1) * A 1 0 + (-2*δ) * A 1 2 + (2*δ) * A 2 1, (1) * A 0 2 + (-δ) * A 1 0 + (-2*δ) * A 1 1 + (2*δ) * A 2 2;
    (δ) * A 0 0 + (2*δ) * A 1 0 + (-1) * A 2 1 + (-δ) * A 2 2, (δ) * A 0 1 + (2*δ) * A 1 1 + (-1) * A 2 0 + (-2*δ) * A 2 2, (δ) * A 0 2 + (2*δ) * A 1 2 + (-δ) * A 2 0 + (-2*δ) * A 2 1]

theorem power1 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : (L δ ^ 1) A = stage1 δ A := by
  simp only [pow_one]
  change H δ * (A) - (A) * H δ = stage1 δ A
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero] <;>
    simp [H, stage1] <;> ring

def stage2 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ :=
  !![(2*δ^2 + 2) * A 0 0 + (2*δ^2) * A 0 1 + (2*δ) * A 0 2 + (2*δ^2) * A 1 0 + (-2) * A 1 1 + (-2*δ) * A 1 2 + (2*δ) * A 2 0 + (-2*δ) * A 2 1 + (-2*δ^2) * A 2 2, (2*δ^2) * A 0 0 + (5*δ^2 + 2) * A 0 1 + (δ) * A 0 2 + (-2) * A 1 0 + (2*δ^2) * A 1 1 + (-4*δ) * A 1 2 + (-2*δ) * A 2 0 + (2*δ) * A 2 1 + (-4*δ^2) * A 2 2, (2*δ) * A 0 0 + (δ) * A 0 1 + (6*δ^2 + 1) * A 0 2 + (-2*δ) * A 1 0 + (-4*δ) * A 1 1 + (2*δ^2) * A 1 2 + (-2*δ^2) * A 2 0 + (-4*δ^2) * A 2 1 + (2*δ) * A 2 2;
    (2*δ^2) * A 0 0 + (-2) * A 0 1 + (-2*δ) * A 0 2 + (5*δ^2 + 2) * A 1 0 + (2*δ^2) * A 1 1 + (2*δ) * A 1 2 + (δ) * A 2 0 + (-4*δ) * A 2 1 + (-4*δ^2) * A 2 2, (-2) * A 0 0 + (2*δ^2) * A 0 1 + (-4*δ) * A 0 2 + (2*δ^2) * A 1 0 + (8*δ^2 + 2) * A 1 1 + (δ) * A 1 2 + (-4*δ) * A 2 0 + (δ) * A 2 1 + (-8*δ^2) * A 2 2, (-2*δ) * A 0 0 + (-4*δ) * A 0 1 + (2*δ^2) * A 0 2 + (2*δ) * A 1 0 + (δ) * A 1 1 + (9*δ^2 + 1) * A 1 2 + (-4*δ^2) * A 2 0 + (-8*δ^2) * A 2 1 + (δ) * A 2 2;
    (2*δ) * A 0 0 + (-2*δ) * A 0 1 + (-2*δ^2) * A 0 2 + (δ) * A 1 0 + (-4*δ) * A 1 1 + (-4*δ^2) * A 1 2 + (6*δ^2 + 1) * A 2 0 + (2*δ^2) * A 2 1 + (2*δ) * A 2 2, (-2*δ) * A 0 0 + (2*δ) * A 0 1 + (-4*δ^2) * A 0 2 + (-4*δ) * A 1 0 + (δ) * A 1 1 + (-8*δ^2) * A 1 2 + (2*δ^2) * A 2 0 + (9*δ^2 + 1) * A 2 1 + (δ) * A 2 2, (-2*δ^2) * A 0 0 + (-4*δ^2) * A 0 1 + (2*δ) * A 0 2 + (-4*δ^2) * A 1 0 + (-8*δ^2) * A 1 1 + (δ) * A 1 2 + (2*δ) * A 2 0 + (δ) * A 2 1 + (10*δ^2) * A 2 2]

theorem power2 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : (L δ ^ 2) A = stage2 δ A := by
  change (L δ ^ (1+1)) A = stage2 δ A
  rw [pow_succ',Module.End.mul_apply]
  have hp := congrArg (fun B => L δ B) (power1 δ A)
  refine hp.trans ?_
  change H δ * (stage1 δ A) - (stage1 δ A) * H δ = stage2 δ A
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero] <;>
    simp [H, stage2, stage1] <;> ring

