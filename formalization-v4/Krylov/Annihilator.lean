theorem power7 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : (L δ ^ 7) A = stage7 δ A := by
  change (L δ ^ (6+1)) A = stage7 δ A
  rw [pow_succ',Module.End.mul_apply]
  have hp := congrArg (fun B => L δ B) (power6 δ A)
  refine hp.trans ?_
  change H δ * (stage6 δ A) - (stage6 δ A) * H δ = stage7 δ A
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero] <;>
    simp [H, stage7, stage6] <;> ring

theorem degree_seven (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) :
    (L δ ^ 7) A - (6*(1+5*δ^2)) • (L δ ^ 5) A +
      (9*(1+5*δ^2)^2) • (L δ ^ 3) A +
      (-4*(1+5*δ^2)^3+432*δ^4) • (L δ) A = 0 := by
  rw [power7,power5,power3]
  have h1 : (L δ) A = stage1 δ A := by simpa using power1 δ A
  rw [h1]
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply,Matrix.add_apply,Matrix.smul_apply,Pi.zero_apply,smul_eq_mul] <;>
    simp [stage7,stage5,stage3,stage1] <;> ring

theorem H_real (δ : ℝ) : H (δ : ℂ) = (Perturbation.hamiltonian δ).map Complex.ofReal := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [H,Perturbation.hamiltonian]


abbrev Index := Fin 3 × Fin 3

def ancillaBlock (A : Matrix Index Index ℂ) (j l : Fin 3) : Matrix (Fin 3) (Fin 3) ℂ :=
  fun i k => A (i,j) (k,l)

def liftedL (δ : ℂ) : Module.End ℂ (Matrix Index Index ℂ) :=
  FactorTwo.commutator (PurifiedCovariance.lift (H δ))

theorem block_commutator (δ : ℂ) (A : Matrix Index Index ℂ) (j l : Fin 3) :
    ancillaBlock (liftedL δ A) j l = L δ (ancillaBlock A j l) := by
  ext i k
  simp [ancillaBlock,liftedL,L,FactorTwo.commutator_apply,
    PurifiedCovariance.lift,Matrix.kronecker,Matrix.kroneckerMap,
    Matrix.mul_apply,Fintype.sum_prod_type,Matrix.one_apply,ite_mul,mul_ite]

theorem block_power (δ : ℂ) (A : Matrix Index Index ℂ) (j l : Fin 3) (n : ℕ) :
    ancillaBlock ((liftedL δ ^ n) A) j l = (L δ ^ n) (ancillaBlock A j l) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ',Module.End.mul_apply,block_commutator,ih,pow_succ',Module.End.mul_apply]

theorem lifted_degree_seven (δ : ℂ) (A : Matrix Index Index ℂ) :
    (liftedL δ ^ 7) A - (6*(1+5*δ^2)) • (liftedL δ ^ 5) A +
      (9*(1+5*δ^2)^2) • (liftedL δ ^ 3) A +
      (-4*(1+5*δ^2)^3+432*δ^4) • (liftedL δ) A = 0 := by
  ext ⟨i,j⟩ ⟨k,l⟩
  have h := degree_seven δ (ancillaBlock A j l)
  rw [← block_power δ A j l 7,← block_power δ A j l 5,
    ← block_power δ A j l 3,← block_commutator δ A j l] at h
  have hh := congrFun (congrFun h i) k
  simpa [ancillaBlock] using hh

end
