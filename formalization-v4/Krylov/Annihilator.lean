theorem power6 (δ : ℂ) (A : Matrix (Fin 3) (Fin 3) ℂ) : (L δ ^ 6) A = stage6 δ A := by
  change (L δ ^ (5+1)) A = stage6 δ A
  rw [pow_succ',Module.End.mul_apply]
  have hp := congrArg (fun B => L δ B) (power5 δ A)
  refine hp.trans ?_
  change H δ * (stage5 δ A) - (stage5 δ A) * H δ = stage6 δ A
  ext i j; fin_cases i <;> fin_cases j <;>
    simp only [Matrix.sub_apply, Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_zero] <;>
    simp [H, stage6, stage5] <;> ring

