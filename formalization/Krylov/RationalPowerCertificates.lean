theorem l32_eq : L^32 = l32 := by
  rw [show (32 : ℕ)=16+16 from rfl,pow_add,l16_eq]
  ext ⟨i,j⟩ ⟨k,l⟩; fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    norm_num [l32,l16,Matrix.mul_apply,Fintype.sum_prod_type,Fin.sum_univ_succ]
theorem l32_frobenius : (∑ i,∑ j,‖(L^32) i j‖^2) = (1059512212601011658635535687356622060030531307567453722441090777908753758103651575647481/19342813113834066795298816000000000000000000000000000000000000000000 : ℝ) := by
  rw [l32_eq]
  simp_rw [← Complex.normSq_eq_norm_sq]
  norm_num [l32,Fintype.sum_prod_type,Fin.sum_univ_succ,Complex.normSq_apply]

theorem H_norm : ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 3) H‖ ≤ 11/10 := by
  apply PowerNormCertificate.norm_le_of_power_frobenius H (complexHamiltonian_hermitian _) 2 (11/10) (by norm_num)
  norm_num only [show (2:ℕ)^2=4 from rfl]
  rw [h4_frobenius]
  norm_num

